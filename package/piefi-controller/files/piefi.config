config main 'main'
 option enabled '1'
 option bind '127.0.0.1'
 option port '8787'
 option database '/etc/piefi/piefi.sqlite3'
 option auth_command '/usr/bin/ndsctl auth'
 option deauth_command '/usr/bin/ndsctl deauth'
 option serial_device '/dev/ttyUSB0'
 option coin_enabled '0'
 option coin_event_url 'http://127.0.0.1:8787/api/v1/coin-event'
 option token_file '/etc/piefi/api.token'
 option session_check_seconds '15'
